{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/resource-pool.schema.json",
  "title": "ResourcePool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_pool_id",
    "provider",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "resource_pool_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "QUOTA",
        "RATE_LIMIT",
        "ACCOUNT",
        "RUNTIME"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
