{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/stream.schema.json",
  "title": "Stream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "state",
    "members",
    "revision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
