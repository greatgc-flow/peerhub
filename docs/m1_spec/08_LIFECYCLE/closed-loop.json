{
  "schema_version": 1,
  "entry_stage": "L0",
  "stages": [
    {
      "id": "L0",
      "name": "Intake",
      "purpose": "Classify evidence and reasons for change.",
      "outputs": [
        "evidence",
        "requirement_or_decision"
      ],
      "next": [
        "L1"
      ],
      "failure_routes": [
        "L8",
        "L10"
      ]
    },
    {
      "id": "L1",
      "name": "RED",
      "purpose": "Capture the failure/contract in a reproducible test or eval.",
      "outputs": [
        "red_evidence"
      ],
      "next": [
        "L2"
      ],
      "failure_routes": [
        "L0",
        "L8"
      ]
    },
    {
      "id": "L2",
      "name": "Build",
      "purpose": "Make the minimum implementation/change.",
      "outputs": [
        "change_set"
      ],
      "next": [
        "L3"
      ],
      "failure_routes": [
        "L1"
      ]
    },
    {
      "id": "L3",
      "name": "Verify",
      "purpose": "Pass deterministic gates and recursive-MECE verification.",
      "outputs": [
        "test_evidence"
      ],
      "next": [
        "L4"
      ],
      "failure_routes": [
        "L2"
      ]
    },
    {
      "id": "L4",
      "name": "Package",
      "purpose": "Verify artifact/hash/fresh install.",
      "outputs": [
        "artifact",
        "hash",
        "clean_install_evidence"
      ],
      "next": [
        "L5"
      ],
      "failure_routes": [
        "L2",
        "L3"
      ]
    },
    {
      "id": "L5",
      "name": "Canary",
      "purpose": "Verify facts on the actual provider/runtime where applicable.",
      "outputs": [
        "canary_evidence"
      ],
      "next": [
        "L6"
      ],
      "failure_routes": [
        "L8",
        "L2"
      ]
    },
    {
      "id": "L6",
      "name": "Release",
      "purpose": "Promote the verified artifact and freeze release evidence.",
      "outputs": [
        "release_evidence_index"
      ],
      "next": [
        "L7"
      ],
      "failure_routes": [
        "L8"
      ]
    },
    {
      "id": "L7",
      "name": "Observe",
      "purpose": "Observe invariants and signals during stabilization.",
      "outputs": [
        "observation_summary"
      ],
      "next": [
        "L10"
      ],
      "failure_routes": [
        "L8"
      ]
    },
    {
      "id": "L8",
      "name": "Learn",
      "purpose": "Reproduce incident/feedback/drift and classify causes/decisions.",
      "outputs": [
        "problem_or_feedback_record"
      ],
      "next": [
        "L9",
        "L10"
      ],
      "failure_routes": [
        "L8"
      ]
    },
    {
      "id": "L9",
      "name": "Improve",
      "purpose": "Update requirement/test/docs/catalog together.",
      "outputs": [
        "linked_improvement"
      ],
      "next": [
        "L1"
      ],
      "failure_routes": [
        "L8"
      ]
    },
    {
      "id": "L10",
      "name": "Close",
      "purpose": "Close the change with a terminal disposition and recurrence watch.",
      "outputs": [
        "closure_evidence"
      ],
      "next": [
        "L0"
      ],
      "failure_routes": [
        "L7",
        "L8"
      ]
    }
  ],
  "invariants": [
    {
      "id": "INV-001",
      "statement": "Stream canonical positions do not collide or duplicate.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-ORDER-001",
        "REQ-CORE-003"
      ]
    },
    {
      "id": "INV-002",
      "statement": "Offset does not move backward or exceed the Stream head.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-OFFSET-002",
        "REQ-OFFSET-003"
      ]
    },
    {
      "id": "INV-003",
      "statement": "A stale/fenced Bridge cannot perform authoritative writes.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-FAULT-005",
        "REQ-BRIDGE-002",
        "REQ-BRIDGE-014"
      ]
    },
    {
      "id": "INV-004",
      "statement": "MAY_HAVE_STARTED is not blindly replayed automatically.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-FAULT-003",
        "REQ-CERTAINTY-001",
        "REQ-CERTAINTY-002"
      ]
    },
    {
      "id": "INV-005",
      "statement": "Diag read-only paths do not change state.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-DIAG-001"
      ]
    },
    {
      "id": "INV-006",
      "statement": "A corrupt authoritative store is not silently repaired or used for continued operation.",
      "on_breach": "INCIDENT",
      "requirements": [
        "REQ-PERSIST-004"
      ]
    },
    {
      "id": "INV-007",
      "statement": "Different payloads with the same idempotency key are not treated as successful.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-IDEM-002",
        "REQ-IDEM-004"
      ]
    },
    {
      "id": "INV-008",
      "statement": "Migration/cutover does not lose or reinterpret committed Core identity, provenance, ordering, idempotency, or Offset invariants.",
      "on_breach": "HOLD_OR_ROLLBACK",
      "requirements": [
        "REQ-MIG-001",
        "REQ-MIG-002"
      ]
    }
  ],
  "closure_requirements": [
    "evidence_linked",
    "requirement_or_decision_linked",
    "test_or_rationale",
    "verification_evidence",
    "release_relation",
    "docs_catalog_schema_impact",
    "terminal_disposition",
    "recurrence_watch",
    "unresolved_problem_link_or_rationale"
  ],
  "terminal_dispositions": [
    "FIXED",
    "ROLLED_BACK",
    "MITIGATED",
    "ACCEPTED_RISK",
    "DEFERRED_WITH_TRIGGER",
    "INVALID_OR_NOT_REPRODUCED",
    "DUPLICATE_LINKED",
    "NO_CHANGE_REQUIRED"
  ]
}
