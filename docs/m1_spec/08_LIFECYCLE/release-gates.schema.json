{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerHub lifecycle release gates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "blocking",
          "evidence",
          "on_fail",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "on_fail": {
            "enum": [
              "FIX",
              "HOLD",
              "ROLLBACK_OR_HOLD",
              "OBSERVE"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^G[0-9]+$"
            }
          }
        }
      }
    }
  }
}
