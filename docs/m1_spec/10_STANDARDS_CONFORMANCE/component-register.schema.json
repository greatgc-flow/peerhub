{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verysimple.local/schema/component-register-v1.json",
  "title": "VerySimple Component Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "as_of",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "plane",
          "component_class",
          "required_for",
          "boundary_roles",
          "maturity",
          "state_ownership",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "plane": {
            "enum": [
              "PRODUCT_RUNTIME",
              "DELIVERY"
            ]
          },
          "component_class": {
            "enum": [
              "CORE",
              "MODULE",
              "EXTENSION",
              "GENERATED_VIEW",
              "EXTERNAL"
            ]
          },
          "product_subtype": {
            "type": "string"
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "boundary_roles": {
            "type": "array",
            "items": {
              "enum": [
                "NONE",
                "ADAPTER",
                "PROVIDER",
                "EXPORTER"
              ]
            },
            "uniqueItems": true
          },
          "maturity": {
            "enum": [
              "PLANNED",
              "DESIGN_FROZEN",
              "IMPLEMENTING",
              "IMPLEMENTED",
              "VERIFIED",
              "DEPRECATED",
              "RETIRED"
            ]
          },
          "state_ownership": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "recovery_class"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "CONFIG",
                    "DOMAIN_DATA",
                    "EVIDENCE",
                    "LOG",
                    "CACHE",
                    "TEMP",
                    "BACKUP",
                    "SCHEMA",
                    "SECRET",
                    "EXTERNAL_REF"
                  ]
                },
                "recovery_class": {
                  "enum": [
                    "AUTHORITATIVE",
                    "DURABLE_DERIVED",
                    "REBUILDABLE",
                    "EPHEMERAL",
                    "EXTERNAL"
                  ]
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
