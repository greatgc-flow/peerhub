{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verysimple.local/schema/product-distribution-v1.json",
  "title": "VerySimple Product Distribution Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "as_of",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_identity",
          "status",
          "channel",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_identity": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_PUBLISHED",
              "CANDIDATE",
              "PUBLISHED",
              "PROMOTED",
              "WITHDRAWN"
            ]
          },
          "channel": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "verification_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROMOTED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "verification_ref",
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
