{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/m1-test-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "count",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "title",
          "requirements",
          "priority",
          "markers",
          "dimensions",
          "case_type",
          "setup",
          "action",
          "oracle",
          "failure_injection",
          "evidence",
          "live_provider",
          "deterministic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "architecture",
              "schema",
              "unit",
              "property",
              "integration",
              "concurrency",
              "fault",
              "e2e",
              "live",
              "package",
              "migration",
              "security",
              "soak",
              "meta"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "case_type": {
            "enum": [
              "positive",
              "negative",
              "boundary",
              "fault",
              "meta"
            ]
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "failure_injection": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "live_provider": {
            "type": "boolean"
          },
          "deterministic": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
