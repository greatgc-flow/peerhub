{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/recursive-mece-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "axes",
    "recursive_rule",
    "stop_condition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "axes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "recursive_rule": {
      "type": "string",
      "minLength": 1
    },
    "stop_condition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
