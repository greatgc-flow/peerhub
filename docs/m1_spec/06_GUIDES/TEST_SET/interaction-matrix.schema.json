{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/interaction-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "interactions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "a",
          "b",
          "risk",
          "status",
          "tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          },
          "b": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REQUIRED",
              "DEFERRED",
              "N_A"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "trigger": {
            "type": "string"
          }
        }
      }
    }
  }
}
