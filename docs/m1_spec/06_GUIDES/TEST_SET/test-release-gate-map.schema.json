{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerHub test to release gate traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_on": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "primary_gate",
          "priority",
          "tier"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "primary_gate": {
            "pattern": "^G[0-9]+$"
          },
          "priority": {
            "enum": [
              "P0",
              "P1"
            ]
          },
          "tier": {
            "type": "string"
          }
        }
      }
    }
  }
}
