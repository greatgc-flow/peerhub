{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/state-machine-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_on",
    "machines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "states",
          "transitions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "from",
                "event",
                "to",
                "status",
                "tests"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string"
                },
                "event": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "COVERED",
                    "DEFERRED",
                    "N_A"
                  ]
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "trigger": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
