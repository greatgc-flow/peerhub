{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/peer-observation.schema.json",
  "title": "PeerObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "subject_ref",
    "kind",
    "source",
    "observed_at",
    "state",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "resource_pool_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "MEASURED",
        "ABSENT",
        "UNAVAILABLE",
        "ERROR",
        "STALE",
        "UNKNOWN"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
