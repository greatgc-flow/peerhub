{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/model-catalog.schema.json",
  "title": "ModelCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "observed_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_revision": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "runtime_kind",
          "model_id",
          "availability",
          "evidence_state"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "runtime_kind": {
            "type": "string"
          },
          "runtime_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_id": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "UNKNOWN"
            ]
          },
          "reasoning_efforts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "context_window": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence_state": {
            "enum": [
              "MEASURED",
              "ABSENT",
              "UNAVAILABLE",
              "ERROR",
              "STALE",
              "UNKNOWN"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
