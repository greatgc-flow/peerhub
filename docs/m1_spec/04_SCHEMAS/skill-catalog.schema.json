{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerhub.example/schemas/skill-catalog.schema.json",
  "title": "SkillCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_revision": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "version",
          "source_path",
          "source_digest",
          "activation"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "activation": {
            "enum": [
              "EXPLICIT",
              "ON_DEMAND",
              "DISABLED"
            ]
          },
          "compatible_runtimes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
