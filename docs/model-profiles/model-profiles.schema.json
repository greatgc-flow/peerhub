{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greatgc-flow/peerhub/docs/model-profiles/model-profiles.schema.json",
  "title": "peerhub model profile refresh recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "tier_rules",
    "update_targets",
    "instructions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint: relative path of this schema."
    },
    "schema_version": {
      "const": 2
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ag",
        "cc",
        "cx"
      ],
      "properties": {
        "ag": {
          "$ref": "#/$defs/source"
        },
        "cc": {
          "$ref": "#/$defs/source"
        },
        "cx": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "tier_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "update_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Repo-relative files that must be edited together."
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Ordered procedure for the AI reading this file."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "parse"
      ],
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "parse": {
          "type": "string"
        }
      }
    }
  }
}
