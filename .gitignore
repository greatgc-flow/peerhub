# PeerHub local runtime state (PathLayout.for_workspace default)
.peerhub/

# hub.py --project-dir ask-temp scratch (peer-subprocess TEMP/TMP when this
# repo is used as an ask target outside hub.py's own default project root)

# Byte-compiled / optimized files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging (this project ships wheels/sdists via
# setuptools; python -m build's default output plus editable-install
# metadata)
.Python
build/
dist/
.eggs/
*.egg-info/
MANIFEST

# Test / coverage tooling actually used by this project (pytest,
# pytest-cov, hypothesis)
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environments -- credential/local-environment exclusions
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# PyPI configuration file -- can carry publish credentials
.pypirc


# Ad-hoc review/probe scratch work (e.g. adversarial design-round probes
# like the one accidentally committed and removed 2026-09-09, see
# docs/reviews/p-drive-folder-structure-mece-review-2026-09-09.md) --
# never meant to be permanent repo content.
scratch/
codex_*/
round*_cx_*/
r[0-9]*-cx-*/
r[0-9]*_deadline_*/
.pytest_tmp_*/
.pytest-*-[0-9a-f]*/
pytest-cache-files-*/
tmp[a-z0-9]*/
search_output.txt
