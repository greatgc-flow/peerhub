# M1 spec package manifests/checksums hash these files byte-for-byte (LF; the 4 CSVs are stored CRLF) and the packaged schemas are byte copies
# of docs/m1_spec/04_SCHEMAS: never let git rewrite line endings (windows runners default to core.autocrlf=true).
/.gitattributes text eol=lf
docs/m1_spec/** -text
peerhub/core/schemas/*.json -text
peerhub/extensions/schemas/*.json -text

/docs/design/monitor-expand-details-2026-10-16.md text eol=lf

